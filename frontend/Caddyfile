{$SITE_ADDRESS:localhost} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
    }
    handle /api/* {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
    }
    handle /health {
        reverse_proxy {$BACKEND_UPSTREAM:backend:8080}
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
