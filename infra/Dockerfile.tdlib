FROM maven:3.9.11-eclipse-temurin-25 AS native
ARG TDLIB_COMMIT=ea97bcdd3a15523c58ddfe772b4547187cf5bbeb
RUN apt-get update && apt-get install -y --no-install-recommends g++ cmake gperf libssl-dev zlib1g-dev git php-cli && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*
RUN git init td && cd td && git remote add origin https://github.com/tdlib/td.git && git fetch --depth 1 origin ${TDLIB_COMMIT} && git checkout --detach FETCH_HEAD
RUN cmake -S /src/td -B /src/td/build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_FLAGS_RELEASE='-O1 -DNDEBUG' -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DCMAKE_INSTALL_PREFIX=/src/td/example/java/td && cmake --build /src/td/build --target install -j 2
RUN cmake -S /src/td -B /src/td/build -DTD_ENABLE_JNI=ON -DJAVA_HOME=${JAVA_HOME} && cmake --build /src/td/build --target install -j 2
RUN cmake -S /src/td/example/java -B /src/java-build -DTD_JSON_JAVA=ON -DTd_DIR=/src/td/example/java/td/lib/cmake/Td -DCMAKE_INSTALL_PREFIX=/opt/tdlib -DJAVA_HOME=${JAVA_HOME} && cmake --build /src/java-build --target install -j 2
RUN printf '%s\n' ${TDLIB_COMMIT} > /opt/tdlib/REVISION
COPY infra/TdlibSmoke.java /src/TdlibSmoke.java
RUN mkdir -p /opt/tdlib/smoke && javac -d /opt/tdlib/smoke /src/TdlibSmoke.java
FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends libssl3t64 zlib1g ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=native /opt/tdlib /opt/tdlib
